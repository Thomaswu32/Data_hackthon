{
  "components": [
    {
      "id": "chat_1",
      "provider": "chat",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "chat"
      },
      "ui": {
        "position": {
          "x": 20,
          "y": 200
        },
        "measured": {
          "width": 150,
          "height": 66
        },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "agent_rocketride_1",
      "provider": "agent_rocketride",
      "config": {
        "agent_description": "Cognee memory proxy for the Compounding Support Desk",
        "instructions": [
          "You only relay calls to the cognee tool. You never invent ticket data.",
          "If asked to recall history, call the cognee recall tool with the given query and return ONLY JSON: {\"matches\":[{\"ticket_id\":\"...\",\"relevance\":0..1,\"reason\":\"...\"}]}.",
          "If asked to remember a resolution, call the cognee remember tool with the given text and return ONLY JSON: {\"stored\":true}.",
          "Never fabricate a ticket_id that was not present in the tool's own results."
        ],
        "max_waves": 3,
        "parameters": {}
      },
      "input": [
        {
          "lane": "questions",
          "from": "chat_1"
        }
      ],
      "ui": {
        "position": {
          "x": 240,
          "y": 140
        },
        "measured": {
          "width": 150,
          "height": 86
        },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "llm_anthropic_1",
      "provider": "llm_gemini",
      "config": {
        "profile": "gemini-2_5-flash",
        "gemini-2_5-flash": {
          "apikey": "${ROCKETRIDE_GEMINI_KEY}"
        },
        "parameters": {}
      },
      "control": [
        {
          "classType": "llm",
          "from": "agent_rocketride_1"
        }
      ],
      "ui": {
        "position": {
          "x": 240,
          "y": 20
        },
        "measured": {
          "width": 150,
          "height": 66
        },
        "nodeType": "default",
        "formDataValid": true
