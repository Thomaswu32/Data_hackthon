        "type": "tool_cognee",
        "base_url": "${ROCKETRIDE_COGNEE_BASE_URL}",
        "api_key": "${ROCKETRIDE_COGNEE_API_KEY}",
        "dataset": "support_desk_tickets",
        "allow_dataset_override": false,
        "search_type": "GRAPH_COMPLETION_DECOMPOSITION",
        "top_k": 5,
        "request_timeout": 60
      },
      "control": [
        {
          "classType": "tool",
          "from": "agent_rocketride_1"
        }
      ],
      "ui": {
        "position": {
