    {
      "id": "agent_rocketride_1",
      "provider": "agent_rocketride",
      "config": {
        "agent_description": "HydraDB persistence proxy for the Compounding Support Desk",
        "instructions": [
          "You only relay calls to the hydradb tool. You never invent ticket data.",
          "When asked to store a resolution memory, call the hydradb store-memory tool with the given text and return ONLY JSON: {\"stored\":true}.",
          "When asked to recall, call the hydradb recall-memory tool and return ONLY JSON: {\"results\":[...]} using whatever the tool returned, verbatim."
        ],
        "max_waves": 3,
        "parameters": {}
      },
      "input": [
        {
          "lane": "questions",
          "from": "chat_1"
        }
      ],
      "ui": {
        "position": {
