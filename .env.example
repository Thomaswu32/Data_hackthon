# =============================================================================
# Compounding Support Desk — environment variables.
#
# Copy this file to `.env` and fill in real values. `.env` itself is
# git-ignored and must never be committed. Every variable a pipeline reads
# MUST start with ROCKETRIDE_ — RocketRide only substitutes that prefix.
# =============================================================================

# --- RocketRide platform (managed by the VS Code extension) ---------------
# Development connection: used for use()/chat()/send(), monitors, the app
# dev loop, and scripts/check-loop's verification script.
ROCKETRIDE_URI=https://staging.rocketride.ai
ROCKETRIDE_APIKEY=your-rocketride-api-key
# Deploy target: used for deploy.*, schedules, publishApp/submitApp, build
# logs. Point this at staging for the hackathon — never deploy to @public.
ROCKETRIDE_DEPLOY_URI=https://staging.rocketride.ai
ROCKETRIDE_DEPLOY_APIKEY=your-rocketride-api-key

# --- LLM provider (required for AI suggestion generation AND for the ------
# --- Cognee/HydraDB agent pipelines, since RocketRide only exposes both --
# --- as agent-invoked tools) -----------------------------------------------
# Set ANY ONE of these. Without one, the suggestion/Cognee/HydraDB adapters
# run in their labeled mock fallback.
ROCKETRIDE_ANTHROPIC_KEY=sk-ant-your-key-here
# ROCKETRIDE_OPENAI_KEY=sk-your-key-here
# ROCKETRIDE_GEMINI_KEY=your-key-here
# ROCKETRIDE_MISTRAL_KEY=your-key-here

# --- Cognee (historical-ticket recall/remember) ----------------------------
# Also requires an LLM key above, since tool_cognee is agent-invoked only.
ROCKETRIDE_COGNEE_BASE_URL=http://localhost:8000
ROCKETRIDE_COGNEE_API_KEY=your-cognee-api-key

# --- HydraDB (cross-session resolution memory, additive to the app's own --
# --- structured ticket store — see README.md "Data & storage") -----------
# Also requires an LLM key above, since db_hydradb is agent-invoked only.
ROCKETRIDE_HYDRADB_API_KEY=your-hydradb-api-key
ROCKETRIDE_HYDRADB_DATABASE=your-hydradb-database-name

# --- Hotdata / Modiq.ai -----------------------------------------------------
# No third-party API keys — see README.md's tool status table for why.
